# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=

AUTH_DB_NAME=dms_auth
DOCUMENTS_DB_NAME=dms_documents
NOTIFICATIONS_DB_NAME=dms_notifications

# ─── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── JWT ──────────────────────────────────────────────────
JWT_PRIVATE_KEY=       # Path to RSA private key (RS256) or inline key
JWT_PUBLIC_KEY=        # Path to RSA public key
JWT_EXPIRES_IN=1h

# ─── Service Ports ────────────────────────────────────────
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=4001
DOCUMENT_SERVICE_PORT=4002
NOTIFICATION_SERVICE_PORT=4003
FILE_STORAGE_PORT=4004

# ─── Service URLs ─────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:4001
DOCUMENT_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_URL=http://localhost:4003
FILE_STORAGE_URL=http://localhost:4004

# ─── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
